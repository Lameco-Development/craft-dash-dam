# Database for the integration tests. The harness DROPS EVERY TABLE in it on each run,
# so point it at a dedicated database — the name must contain "test" or the harness
# refuses to start. Create it once: CREATE DATABASE dash_dam_test;
#
# Variables already present in the environment win over this file, which is how CI
# provides its service-container credentials.
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=127.0.0.1
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=dash_dam_test
CRAFT_DB_USER=root
CRAFT_DB_PASSWORD=
