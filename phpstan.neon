includes:
    - vendor/craftcms/phpstan/phpstan.neon

parameters:
    level: 4
    paths:
        - src
        - tests
    excludePaths:
        # The integration-test app writes runtime state (compiled classes, logs) here.
        - tests/_craft/storage
    # Tests deliberately assert things the PHPDoc type already promises — e.g. that
    # Plugin::getInstance() didn't come back null — so a failure names the real cause
    # instead of surfacing as a fatal error two lines further down.
    treatPhpDocTypesAsCertain: false
