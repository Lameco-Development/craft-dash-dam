{% import '_includes/forms.twig' as forms %}

<p class="light">
    {{ 'The credential settings hold references to environment variables, resolved when the plugin talks to Dash. Never paste a secret in directly — these settings are committed to project config, and secrets must not be. Which Dash folders are synced is set by the client under Utilities → Dash, so a deploy cannot revert their choice.'|t('dash-dam') }}
</p>

{{ forms.autosuggestField({
    label: 'Client ID'|t('dash-dam'),
    instructions: 'The Dash API client id — copy it from Admin → Integrations → REST API in Dash.'|t('dash-dam'),
    id: 'clientId',
    name: 'clientId',
    suggestEnvVars: true,
    value: settings.clientId,
    errors: settings.getErrors('clientId'),
}) }}

{{ forms.autosuggestField({
    label: 'Client secret'|t('dash-dam'),
    instructions: 'From the same place as the client id. Reference an environment variable — never the literal secret, which would be committed to project config.'|t('dash-dam'),
    id: 'clientSecret',
    name: 'clientSecret',
    suggestEnvVars: true,
    value: settings.clientSecret,
    errors: settings.getErrors('clientSecret'),
}) }}

{{ forms.autosuggestField({
    label: 'Subdomain'|t('dash-dam'),
    instructions: 'The tenant part of your Dash URL — “acme” from acme.dash.app.'|t('dash-dam'),
    id: 'subdomain',
    name: 'subdomain',
    suggestEnvVars: true,
    value: settings.subdomain,
    errors: settings.getErrors('subdomain'),
}) }}

{{ forms.autosuggestField({
    label: 'Refresh token'|t('dash-dam'),
    instructions: 'Obtained once with `php craft dash/auth`. Reference an environment variable — never the literal token, which would be committed to project config.'|t('dash-dam'),
    id: 'refreshToken',
    name: 'refreshToken',
    suggestEnvVars: true,
    value: settings.refreshToken,
    errors: settings.getErrors('refreshToken'),
}) }}

{{ forms.autosuggestField({
    label: 'Redirect URI'|t('dash-dam'),
    instructions: 'Where Dash sends the browser back after authorising. It must exactly match a callback URL registered on the Dash API client — matching includes the path. When the variable is unset, the primary site’s origin is used.'|t('dash-dam'),
    id: 'redirectUri',
    name: 'redirectUri',
    suggestEnvVars: true,
    value: settings.redirectUri,
    errors: settings.getErrors('redirectUri'),
}) }}

<hr>

{{ forms.textField({
    label: 'Full reconcile interval'|t('dash-dam'),
    instructions: 'Minutes before the cheap probe is no longer trusted and a full pass runs anyway. This is the only thing that notices a file replaced in Dash under the same name, because a replacement inherits its original upload date and never enters the “changed since” window.'|t('dash-dam'),
    id: 'fullReconcileMinutes',
    name: 'fullReconcileMinutes',
    type: 'number',
    min: 1,
    step: 1,
    size: 6,
    unit: 'minutes'|t('dash-dam'),
    value: settings.fullReconcileMinutes,
    errors: settings.getErrors('fullReconcileMinutes'),
    required: true,
}) }}

{{ forms.textField({
    label: 'Maximum orphan share'|t('dash-dam'),
    instructions: 'Between 0 and 1. If a larger share of mapped assets stops coming back from Dash in one run, the whole reconcile is refused and nothing is changed — an unshared folder or a partial API response looks exactly like a bulk deletion from here. Set to 1 to disable the check.'|t('dash-dam'),
    id: 'maxOrphanShare',
    name: 'maxOrphanShare',
    type: 'number',
    min: 0,
    max: 1,
    step: 0.05,
    size: 6,
    value: settings.maxOrphanShare,
    errors: settings.getErrors('maxOrphanShare'),
    required: true,
}) }}

{{ forms.textField({
    label: 'Transform batch size'|t('dash-dam'),
    instructions: 'How many assets one run may pre-generate image transforms for. Every asset costs a download from Dash against a metered monthly allowance, so a first pass over an established library is spread across runs — anything left over is reported and picked up by the next run.'|t('dash-dam'),
    id: 'maxAssetsPerRun',
    name: 'maxAssetsPerRun',
    type: 'number',
    min: 1,
    step: 1,
    size: 6,
    unit: 'assets'|t('dash-dam'),
    value: settings.maxAssetsPerRun,
    errors: settings.getErrors('maxAssetsPerRun'),
    required: true,
}) }}

{{ forms.textField({
    label: 'Dash title field'|t('dash-dam'),
    instructions: 'Which Dash field holds the title. Dash’s own default is “Title”, but the name follows the language the account was set up in. List several, separated by commas, and the first one that exists wins. If none match, Craft titles are left alone rather than blanked.'|t('dash-dam'),
    id: 'titleFieldNames',
    name: 'titleFieldNames',
    value: settings.titleFieldNames,
    errors: settings.getErrors('titleFieldNames'),
}) }}

{{ forms.textField({
    label: 'Dash alt-text field'|t('dash-dam'),
    instructions: 'Dash ships no alt-text field, so each account creates its own and names it whatever suits. Name it here, exactly as it appears under Admin → Fields in Dash — matching ignores case. List several, separated by commas, and the first one that exists wins. If none match, no alt text is synced at all, which is what keeps an unconfigured account from writing empty values over Craft’s.'|t('dash-dam'),
    id: 'altFieldNames',
    name: 'altFieldNames',
    value: settings.altFieldNames,
    errors: settings.getErrors('altFieldNames'),
}) }}

{{ forms.lightswitchField({
    label: 'Trash deleted assets'|t('dash-dam'),
    instructions: 'Whether an asset deleted in Dash may be moved to Craft’s trash. An asset something still uses is never trashed either way — those are reported under Utilities → Dash. Turn this off to report every deletion and trash nothing.'|t('dash-dam'),
    id: 'trashOrphans',
    name: 'trashOrphans',
    on: settings.trashOrphans,
    errors: settings.getErrors('trashOrphans'),
}) }}
