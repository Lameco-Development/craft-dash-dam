{% import '_includes/forms.twig' as forms %}

{% macro ownerLink(owner) %}
    {%- if owner.cpEditUrl -%}
        <a href="{{ owner.cpEditUrl }}">{{ owner.title ?: owner.id }}</a>
    {%- else -%}
        {{ owner.title ?: owner.id }}
    {%- endif -%}
{% endmacro %}
{% from _self import ownerLink %}

{% if syncFolders is empty %}
    <p class="warning with-icon">
        {{ 'Nothing is being synced yet. Pick the Dash folders that belong in Craft under “Synced folders” below, then save.'|t('dash-dam') }}
    </p>
{% endif %}

<div class="flex flex-nowrap" style="align-items: baseline; justify-content: space-between;">
    <p class="light">
        {% if lastSync %}
            {{ 'Last verified against Dash'|t('dash-dam') }}: {{ lastSync|datetime('short') }}
        {% else %}
            {{ 'Dash has not been synced here yet.'|t('dash-dam') }}
        {% endif %}
    </p>

    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('dash-dam/config/sync') }}
        {{ redirectInput('utilities/dash') }}
        <button type="submit" class="btn">{{ 'Sync now'|t('dash-dam') }}</button>
    </form>
</div>

<p class="light">
    {{ 'Use this when you want a change from Dash straight away. Otherwise the site picks changes up on its own schedule.'|t('dash-dam') }}
</p>

<h2>{{ 'Deleted in Dash, still here'|t('dash-dam') }}</h2>

{% if missing is empty %}
    <p class="zilch">
        {{ 'Nothing is broken. Every asset here still exists in Dash.'|t('dash-dam') }}
    </p>
{% else %}
    <p>
        {{ 'These were deleted in Dash. Craft kept them, because throwing away an asset a page still uses would break that page. The files are gone either way, so the images will not load.'|t('dash-dam') }}
    </p>
    <p>
        <strong>{{ 'To resolve one'|t('dash-dam') }}:</strong>
        {{ 'put it back in Dash and the next sync restores it, or swap it out on the pages listed here and the sync clears it away by itself.'|t('dash-dam') }}
    </p>

    <table class="data fullwidth">
        <thead>
            <tr>
                <th>{{ 'Asset'|t('dash-dam') }}</th>
                <th>{{ 'Location'|t('dash-dam') }}</th>
                <th>{{ 'Used by'|t('dash-dam') }}</th>
                <th>{{ 'Gone since'|t('dash-dam') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for assetId, missingSince in missing %}
                {% set asset = assets[assetId] ?? null %}
                {% set owners = usedBy[assetId] ?? [] %}
                <tr>
                    <td>
                        <span class="status red"></span>
                        {% if asset %}
                            <a href="{{ asset.cpEditUrl }}">{{ asset.title ?: asset.filename }}</a>
                        {% else %}
                            <span class="light">#{{ assetId }} ({{ 'no longer in Craft'|t('dash-dam') }})</span>
                        {% endif %}
                    </td>
                    <td class="light">{{ asset ? asset.path : '—' }}</td>
                    <td>
                        {% if owners is empty %}
                            <span class="light">
                                {{- trashOrphans
                                    ? 'no longer used, clears at the next sync'|t('dash-dam')
                                    : 'nothing'|t('dash-dam') -}}
                            </span>
                        {% else %}
                            {%- for owner in owners|slice(0, 5) -%}
                                {%- if not loop.first %}, {% endif -%}
                                {{ ownerLink(owner) }}
                            {%- endfor -%}
                            {%- if owners|length > 5 %}
                                {# A <details> disclosure rather than capping the list silently:
                                   every owner stays a real, clickable link, it just costs a
                                   click to reveal the ones past the first five. #}
                                <details class="dash-used-by-more">
                                    <summary class="light">{{ 'and {n} more'|t('dash-dam', { n: owners|length - 5 }) }}</summary>
                                    {%- for owner in owners|slice(5) -%}
                                        {%- if not loop.first %}, {% endif -%}
                                        {{ ownerLink(owner) }}
                                    {%- endfor -%}
                                </details>
                            {% endif %}
                        {% endif %}
                    </td>
                    <td class="light">{{ missingSince|datetime('short') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}

<hr>

<h2>{{ 'Synced folders'|t('dash-dam') }}</h2>

{% if availableFolders is null %}
    <p class="error">
        {{ 'Could not reach Dash to list the folders. Nothing has changed; try again once Dash is back.'|t('dash-dam') }}
    </p>
{% elseif availableFolders is empty %}
    <p class="zilch">{{ 'Dash reports no folders on this account.'|t('dash-dam') }}</p>
{% else %}
    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('dash-dam/config/save-folders') }}
        {{ redirectInput('utilities/dash') }}

        <p>
            {{ 'Choose which Dash folders are synced into Craft. Selecting a folder includes everything filed beneath it. With nothing selected, nothing is synced.'|t('dash-dam') }}
        </p>

        {{ forms.checkboxSelectField({
            label: 'Folders'|t('dash-dam'),
            name: 'syncFolders',
            options: availableFolders|map(path => { label: path, value: path }),
            values: syncFolders,
            showAllOption: true,
        }) }}

        <p class="light">
            {{ 'Removing a folder here deletes nothing. Assets already in Craft stay exactly where they are; they just stop being updated.'|t('dash-dam') }}
        </p>

        <div class="buttons">
            <button type="submit" class="btn submit">{{ 'Save'|t('dash-dam') }}</button>
        </div>
    </form>
{% endif %}
