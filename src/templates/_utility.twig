{% import '_includes/forms.twig' as forms %}

{% if lastSync %}
    <p class="light">
        {{ 'Last verified against Dash'|t('_craft-dash') }}:
        {{ lastSync|datetime('short') }}
    </p>
{% else %}
    <p class="light">{{ 'Dash has never been synced on this environment.'|t('_craft-dash') }}</p>
{% endif %}

<h2>{{ 'Deleted in Dash, still here'|t('_craft-dash') }}</h2>

{% if missing is empty %}
    <p class="zilch">
        {{ 'Nothing is broken. Every asset in the Dash volume still exists in Dash.'|t('_craft-dash') }}
    </p>
{% else %}
    <p>
        {{ 'These assets were removed from Dash but were kept in Craft, because deleting one that a page still uses would break that page. Their files are gone, so any image transform generated from them will fail.'|t('_craft-dash') }}
    </p>
    <p>
        <strong>{{ 'To resolve one'|t('_craft-dash') }}:</strong>
        {{ 'either restore it in Dash — the next sync picks it up automatically — or replace it on the pages listed below, after which the sync removes it on its own.'|t('_craft-dash') }}
    </p>

    <table class="data fullwidth">
        <thead>
            <tr>
                <th>{{ 'Asset'|t('_craft-dash') }}</th>
                <th>{{ 'Location'|t('_craft-dash') }}</th>
                <th>{{ 'Used by'|t('_craft-dash') }}</th>
                <th>{{ 'Gone since'|t('_craft-dash') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for assetId, missingSince in missing %}
                {% set asset = assets[assetId] ?? null %}
                <tr>
                    <td>
                        <span class="status red"></span>
                        {% if asset %}
                            <a href="{{ asset.cpEditUrl }}">{{ asset.title ?: asset.filename }}</a>
                        {% else %}
                            <span class="light">#{{ assetId }} ({{ 'no longer in Craft'|t('_craft-dash') }})</span>
                        {% endif %}
                    </td>
                    <td class="light">{{ asset ? asset.path : '—' }}</td>
                    <td>
                        {% set used = uses[assetId] ?? 0 %}
                        {% if used > 0 %}
                            {{ '{n, plural, =1{1 element} other{# elements}}'|t('_craft-dash', { n: used }) }}
                        {% else %}
                            <span class="light">{{ 'nothing'|t('_craft-dash') }}</span>
                        {% endif %}
                    </td>
                    <td class="light">{{ missingSince|datetime('short') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}

<hr>

<h2>{{ 'Synced folders'|t('_craft-dash') }}</h2>

{% if availableFolders is null %}
    <p class="error">
        {{ 'Could not reach Dash to list the folders. The selection below is unchanged; try again once Dash is reachable.'|t('_craft-dash') }}
    </p>
{% elseif availableFolders is empty %}
    <p class="zilch">{{ 'Dash reports no folders on this account.'|t('_craft-dash') }}</p>
{% else %}
    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('_craft-dash/config/save-folders') }}
        {{ redirectInput('utilities/dash') }}

        <p>
            {{ 'Choose which Dash folders are synced into Craft. Selecting a folder includes everything filed beneath it. With nothing selected, every folder is synced.'|t('_craft-dash') }}
        </p>

        {{ forms.checkboxSelectField({
            label: 'Folders'|t('_craft-dash'),
            name: 'syncFolders',
            options: availableFolders|map(path => { label: path, value: path }),
            values: syncFolders,
            showAllOption: true,
        }) }}

        <p class="light">
            {{ 'Removing a folder here does not delete anything. Assets already in Craft from that folder are left exactly as they are — they simply stop being kept up to date.'|t('_craft-dash') }}
        </p>

        <div class="buttons">
            <button type="submit" class="btn submit">{{ 'Save'|t('_craft-dash') }}</button>
        </div>
    </form>
{% endif %}
